		"@jest/globals": "^30.4.1",
		"@types/node": "^24.13.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^16.5.0",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.12",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.65.0"
	},
	"dependencies": {
		"handlebars": "^4.7.9",
		"obsidian": "1.13.1",
		"pdfjs-dist": "^6.2.108"
	},
	"overrides": {
